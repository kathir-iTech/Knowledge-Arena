# ============================================================
# Knowledge Arena — Environment Variables
# Copy this file to `.env` (or `.env.local` for local dev) and
# fill in real values. NEVER commit the real `.env` or
# `service-account.json`.
# ============================================================

# --- Firebase Client (public) ---
# Used by the browser SDK. Values below match the current Firebase
# project; the auth domain can be overridden if you use a custom
# domain in Firebase console.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-4092189688-c74a7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Realtime Database URL (public) used for live battle presence. Create the RTDB
# instance in the Firebase console and override with its region-specific URL if
# it is not in the default (us-central1) location.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://studio-4092189688-c74a7-default-rtdb.firebaseio.com

# --- Gladiator access (Part 5A: per-arena, not global signup) ---
# Legacy global var still read by old scripts but NO LONGER ENFORCED at signup.
# Signup is open: any Google account may create a gladiator profile.
# Domain is enforced at arena-join via quizzes.allowed_gladiator_domain
# (snapshot of Commander users.institution_domain, default psgitech.ac.in).
# Blank/null = open arena (fail-open). See src/services/arena-creation.service.ts:93
# and firestore.rules:38 getAllowedGladiatorDomain().
# The old global vars below are kept for backward compat only; set blank.
ALLOWED_GLADIATOR_EMAIL_DOMAIN=
NEXT_PUBLIC_ALLOWED_GLADIATOR_EMAIL_DOMAIN=

# --- Firebase Admin (server-only) ---
# Provide the service account as raw JSON in a single line:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
#   OR
# SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
#   OR
# place `service-account.json` in the project root.
# If unset, the Admin SDK falls back to Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
# SERVICE_ACCOUNT_PATH=

# --- AI Generation (Gemini / Genkit) ---
# Preferred: GEMINI_API_KEYS — comma-separated list of Gemini API keys from
# different Google accounts. The central key-resolver (src/ai/key-resolver.ts)
# rotates round-robin and automatically skips any key that hits a 429/quota error,
# cooling it down for Google's retryDelay (or 60s default) before reuse.
# - Each free-tier Google account contributes its own ~20-requests/minute quota,
#   so GEMINI_API_KEYS="key1,key2,key3" triples capacity without code changes.
# - If ALL keys are in cooldown, the resolver waits bounded (max 15s) for the
#   shortest remaining cooldown, otherwise fails fast with "ALL_GEMINI_KEYS_EXHAUSTED" —
#   never hangs indefinitely.
# - The optional `scope` param on getGeminiApiKey(scope?) is reserved for future
#   per-client key assignment (e.g., paying client gets dedicated key) without
#   rewriting call sites — only resolver internals need to change.
# - Backward compat: GOOGLE_GENERATIVE_AI_API_KEY, GEMINI_API_KEY, GOOGLE_API_KEY,
#   GOOGLE_GENAI_API_KEY are still read if GEMINI_API_KEYS is unset (single-key mode
#   behaves exactly as before — no behavior change when only one key is configured).
# - For production, upgrading the underlying Google Cloud project(s) to billed
#   pay-as-you-go removes the low free-tier ceiling entirely and is the recommended
#   production path (quota then scales with billing, not free-tier limits).
#
# Example (multi-key):
# GEMINI_API_KEYS=AIzaSy...key1...,AIzaSy...key2...,AIzaSy...key3...
#
# Fallback single-key (legacy, still supported):
GEMINI_API_KEYS=
GOOGLE_GENERATIVE_AI_API_KEY=
