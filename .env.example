# ============================================================
# Knowledge Arena — Environment Variables
# Copy this file to `.env` (or `.env.local` for local dev) and
# fill in real values. NEVER commit the real `.env` or
# `service-account.json`.
# ============================================================

# --- Firebase Client (public) ---
# Used by the browser SDK. Values below match the current Firebase
# project; the auth domain can be overridden if you use a custom
# domain in Firebase console.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=studio-4092189688-c74a7.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# Realtime Database URL (public) used for live battle presence. Create the RTDB
# instance in the Firebase console and override with its region-specific URL if
# it is not in the default (us-central1) location.
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://studio-4092189688-c74a7-default-rtdb.firebaseio.com

# --- Firebase Admin (server-only) ---
# Provide the service account as raw JSON in a single line:
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
#   OR
# SERVICE_ACCOUNT_PATH=C:\path\to\service-account.json
#   OR
# place `service-account.json` in the project root.
# If unset, the Admin SDK falls back to Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY=
# SERVICE_ACCOUNT_PATH=

# --- AI Generation (Gemini / Genkit) ---
# Required for AI Forge (PDF/quiz generation) and the PDF flow.
# GOOGLE_GENERATIVE_AI_API_KEY is the app's documented variable and is passed
# to the Genkit googleAI plugin explicitly. GEMINI_API_KEY / GOOGLE_API_KEY
# are read natively by the plugin and also supported.
GOOGLE_GENERATIVE_AI_API_KEY=
