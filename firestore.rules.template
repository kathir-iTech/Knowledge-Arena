rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isCommander() {
      return isSignedIn() && getRole() == 'commander';
    }

    function isExecutive() {
      return isSignedIn() && getRole() == 'executive';
    }

    function isGladiator() {
      return isSignedIn() && getRole() == 'gladiator';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Gladiator email-domain lock ---
    // The allowed domain is injected at deploy time by
    // scripts/generate-firestore-rules.js (npm run rules:generate); it reads the
    // ALLOWED_GLADIATOR_EMAIL_DOMAIN environment variable. An empty value
    // disables the restriction. The value is regex-escaped by the generator.
    function allowedGladiatorEmailDomain() {
      return '{{ALLOWED_GLADIATOR_EMAIL_DOMAIN}}';
    }

    function isAllowedGladiatorEmail(data) {
      let domain = allowedGladiatorEmailDomain();
      let email = data.keys().hasAll(['email']) ? data.email : '';
      let notAllowed = !(email is string) || email == '';
      // Firestore rules are expression-only (no if statements), so the guard is
      // a ternary chain; the matches() branch is only evaluated when the email is
      // a non-empty string.
      return domain == '' ? true : (notAllowed ? false : email.lower().matches('.*@' + domain + '$'));
    }

    function isQuizCreator(quizId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      return isSignedIn() && exists(quizPath) && get(quizPath).data.created_by == request.auth.uid;
    }

    // Batch-aware version: uses getAfter()/existsAfter() so subcollection creates
    // within an atomic writeBatch can see the parent quiz being created in the same batch.
    function isQuizCreatorAfter(quizId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      return isSignedIn() && existsAfter(quizPath) && getAfter(quizPath).data.created_by == request.auth.uid;
    }

    function isNotBlocked(quizId, userId) {
      let partPath = /databases/$(database)/documents/quizzes/$(quizId)/participants/$(userId);
      return !exists(partPath) || get(partPath).data.status != 'blocked';
    }

    // Pre-submission guard: a submission is only accepted for the arena's
    // CURRENT question for this participant. Question doc ids are UUIDs (not
    // indices), so the binding resolves through the per-participant shuffled
    // order when present (independent mode) and otherwise through the question's
    // sort_index vs the quiz's current_question_index (synchronized mode). This
    // stops pre-writing answers for questions that have not started yet.
    function isCurrentQuestion(quizId, userId, questionId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      let questionPath = /databases/$(database)/documents/quizzes/$(quizId)/questions/$(questionId);
      let partPath = /databases/$(database)/documents/quizzes/$(quizId)/participants/$(userId);
      // Member access on a missing map key raises an evaluation error in rules,
      // and `??` is not supported, so field presence is probed via keys().hasAll.
      let part = exists(partPath) ? get(partPath).data : null;
      let hasOrder = part != null && part.keys().hasAll(['question_order']);
      return hasOrder ? (
        part.question_order[(part.keys().hasAll(['current_question_index']) ? part.current_question_index : 0)] == questionId
      ) : (
        exists(questionPath) && get(questionPath).data.sort_index == get(quizPath).data.current_question_index
      );
    }

    function isQuizParticipant(quizId, userId) {
      let partPath = /databases/$(database)/documents/quizzes/$(quizId)/participants/$(userId);
      return isSignedIn() && exists(partPath);
    }

    // Battle Engine state machine: every status transition is validated.
    // Mirrors ALLOWED_QUIZ_TRANSITIONS in src/lib/constants.ts (plus no-op).
    function isLegalStatusTransition(from, to) {
      return (from == 'draft' && to == 'waiting') ||
        (from == 'waiting' && (to == 'ready' || to == 'starting')) ||
        (from == 'ready' && (to == 'waiting' || to == 'starting')) ||
        (from == 'starting' && (to == 'live' || to == 'waiting')) ||
        (from == 'live' && (to == 'paused' || to == 'finished')) ||
        (from == 'paused' && (to == 'live' || to == 'finished')) ||
        (from == 'finished' && to == 'archived') ||
        from == to;
    }

    // Client creators may only mutate a whitelist of fields, and only along
    // validated transitions. created_by (ownership) is server-only.
    // scoring_config and skipped_question_ids were removed in Phase 94: they
    // now live in the gated quizzes/{quizId}/config/settings document so
    // pre-join readers of the parent doc never see scoring or internal state.
    function isLegalQuizUpdate(quizId) {
      return isQuizCreator(quizId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'archived', 'status', 'current_question_index', 'question_start_at',
          'commanderLastSeen', 'battle_mode', 'start_config',
          'paused_at', 'paused_ms', 'started_at', 'ended_at',
          'owner_transferred_at',
        ]) &&
        isLegalStatusTransition(resource.data.status, request.resource.data.status) &&
        request.resource.data.status in ['waiting', 'ready', 'starting', 'live', 'paused', 'finished', 'archived'];
    }

    // Arena internals live in quizzes/{quizId}/config/settings. Only the
    // Commander, participants who have already joined, and executives may read
    // them — never a non-participant who merely knows the room code.
    function canReadQuizConfig(quizId) {
      return isSignedIn() && (
        isQuizCreator(quizId) ||
        isQuizParticipant(quizId, request.auth.uid) ||
        isExecutive()
      );
    }

    // Least-privilege arena read: executives see everything; commanders and
    // gladiators may only read arenas they created or participate in. Open
    // (waiting/ready) arenas are readable so gladiators can discover them via
    // the join flow, but their questions remain restricted to participants.
    function canReadArena(quizId) {
      let quizPath = /databases/$(database)/documents/quizzes/$(quizId);
      return isSignedIn() && exists(quizPath) && (
        isQuizCreator(quizId) ||
        isQuizParticipant(quizId, request.auth.uid) ||
        get(quizPath).data.status in ['waiting', 'ready']
      );
    }

    // Questions are only visible to arena participants, the creator and
    // executives. Open arenas are listed for joining, but their question
    // content is never exposed to non-participants.
    function canReadArenaContent(quizId) {
      return isSignedIn() && (
        isQuizCreator(quizId) ||
        isQuizParticipant(quizId, request.auth.uid) ||
        isExecutive()
      );
    }

    // --- Rules ---

    match /users/{userId} {
      // Profiles may only be read by the owner and executives (admin). Roster
      // identity travels in participant docs and all cross-user reads (messaging,
      // executive workspace/search/analytics) go through the Admin SDK, so
      // commanders have no client-side read need — preventing roster enumeration.
      allow read: if isOwner(userId) || isExecutive();
      // Self-signup: only gladiator role allowed (no privilege escalation),
      // only the profile fields a gladiator may set for themselves, and only an
      // email inside the institution's allowed domain (where one is configured).
      allow create: if isOwner(userId)
        && request.resource.data.role == 'gladiator'
        && isAllowedGladiatorEmail(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'email', 'avatar', 'role', 'onboarding_complete']);
      // Owners may only update their display name and avatar, and mark onboarding complete. Role, email,
      // mustChangePassword, disabled and all other fields are server-only.
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar', 'onboarding_complete']);
    }

    match /quizzes/{quizId} {
      // Commander room-code collision check: allow get of a quiz that doesn't exist yet so
      // createArenaAtomic() can verify the generated room code is unique. Restricted to
      // commanders/executives — gladiators never need to probe non-existent arenas.
      // Collection-list fix: onSnapshot/getDocs with where('created_by','==',uid) or
      // where('status','in',['waiting','ready']) must be allowed. canReadArena uses
      // get()/exists() on the parent which returns Null for 'list' evaluation; resource
      // checks handle list queries directly. This is the listener that was failing on
      // create-quiz (Commander quiz list refresh).
      allow read: if isExecutive()
        || canReadArena(quizId)
        || (isCommander() && !exists(/databases/$(database)/documents/quizzes/$(quizId)))
        || (isSignedIn() && resource != null && resource.data.created_by == request.auth.uid)
        || (isSignedIn() && resource != null && resource.data.status in ['waiting', 'ready']);
      allow create: if isSignedIn() && (getRole() == 'commander' || getRole() == 'executive')
        && request.resource.data.created_by == request.auth.uid;
      allow update: if isLegalQuizUpdate(quizId);
      allow delete: if isQuizCreator(quizId);

      match /questions/{questionId} {
        allow read: if canReadArenaContent(quizId);
        // isQuizCreatorAfter supports atomic writeBatch where parent quiz is created
        // in the same batch — getAfter() sees the pending parent.
        allow create: if isQuizCreator(quizId) || isQuizCreatorAfter(quizId);
        allow update, delete: if isQuizCreator(quizId);

        match /submissions/{userId} {
          allow read: if isExecutive() || isQuizCreator(quizId) || isOwner(userId);
          // Submissions are only accepted while the battle is live (canSubmitAnswer
          // semantics enforced server-side as well), only by the owner, and only
          // for the arena's current question (pre-submission / question-id-forging
          // guard). The question_id field must also match the doc path it is written to.
          allow create: if isOwner(userId) && isNotBlocked(quizId, userId)
            && isQuizParticipant(quizId, userId)
            && get(/databases/$(database)/documents/quizzes/$(quizId)).data.status == 'live'
            && isCurrentQuestion(quizId, userId, questionId)
            && request.resource.data.question_id == questionId
            && request.resource.data.selected_option >= 0
            && request.resource.data.selected_option <= 3
            && request.resource.data.keys().hasOnly(['question_id', 'selected_option', 'submittedAt', 'clientTime'])
            && request.resource.data.submittedAt == request.time;
          allow update: if false;
          allow delete: if isQuizCreator(quizId);
        }
      }

      match /answerKeys/{questionId} {
        allow read: if isExecutive() || isQuizCreator(quizId) || (
          isSignedIn() &&
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.status == 'finished' &&
          isQuizParticipant(quizId, request.auth.uid)
        );
        // isQuizCreatorAfter supports atomic writeBatch where parent quiz is created
        // in the same batch.
        allow create: if isQuizCreator(quizId) || isQuizCreatorAfter(quizId);
        allow update, delete: if isQuizCreator(quizId);
      }

      match /participants/{userId} {
        // Open arenas (waiting/ready) expose their roster so gladiators can
        // see who is in the room before joining; live/finished arenas are
        // restricted to members, the creator and executives.
        allow read: if isExecutive() || canReadArena(quizId);
        // isOwner(userId) handles both Commander creating their own participant in
        // the arena creation batch AND Gladiators joining later.
        // getAfter(quizPath) supports atomic batch where parent quiz is created
        // in the same batch — getAfter() sees the pending parent with status 'waiting'.
        allow create: if isOwner(userId)
          && isNotBlocked(quizId, userId)
          && request.resource.data.user_id == userId
          && request.resource.data.lastSeen == request.time
          && request.resource.data.keys().hasOnly(['user_id', 'score', 'status', 'violations_count', 'ready', 'lastSeen', 'session_token', 'name'])
          && getAfter(/databases/$(database)/documents/quizzes/$(quizId)).data.status in ['waiting', 'ready'];
        // Commander can update everyone (block/reset/flag). Gladiators can only:
        //  - increment violations (or block/flag themselves) in a single write
        //  - send heartbeat (lastSeen) updates, optionally with their session token
        //  - toggle the ready flag while the arena is waiting/ready
        allow update: if isQuizCreator(quizId) || (
          isOwner(userId) && (
            (
              request.resource.data.violations_count > resource.data.violations_count &&
              (
                request.resource.data.diff(resource.data).affectedKeys().hasOnly(['violations_count']) ||
                (
                  request.resource.data.diff(resource.data).affectedKeys().hasOnly(['violations_count', 'status']) &&
                  request.resource.data.status in ['blocked', 'flagged']
                )
              )
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen']) &&
              request.resource.data.lastSeen == request.time
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'session_token']) &&
              request.resource.data.lastSeen == request.time &&
              request.resource.data.session_token is string
            ) ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ready']) &&
              request.resource.data.ready is bool &&
              get(/databases/$(database)/documents/quizzes/$(quizId)).data.status in ['waiting', 'ready']
            )
          )
        );
        allow delete: if isQuizCreator(quizId) || (
          isOwner(userId) &&
          get(/databases/$(database)/documents/quizzes/$(quizId)).data.status == 'waiting' &&
          resource.data.status != 'blocked'
        );
      }

      // Gated arena internals (Phase 94): scoring_config and skip bookkeeping
      // moved here so a non-participant who only knows the room code can never
      // read how scoring is calculated or which questions were skipped before
      // joining. Server-side battle flows read/write this document via the
      // Admin SDK (rules-bypassing) and are unaffected.
      match /config/{docId} {
        allow read: if canReadQuizConfig(quizId);
        // Batch-create timing fix: in an atomic writeBatch the parent quiz doc and
        // config/settings are created together, but Firestore evaluates each doc
        // independently — exists()/get() does NOT yet see the pending parent.
        // isQuizCreatorAfter (existsAfter/getAfter) handles the batch case, but we
        // also allow a direct ownership fallback via the config doc's own created_by
        // field so the batch succeeds even if the emulator/production evaluation order
        // differs. Least-privilege: only the owner (or an executive) may create.
        allow create: if (
            isQuizCreator(quizId)
            || isQuizCreatorAfter(quizId)
            || isExecutive()
            || (request.resource.data.keys().hasAll(['created_by']) && request.resource.data.created_by == request.auth.uid)
          )
          && request.resource.data.keys().hasOnly(['scoring_config', 'governance_config', 'skipped_question_ids', 'created_by']);
        allow update: if (isQuizCreator(quizId) || isExecutive())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scoring_config', 'governance_config', 'skipped_question_ids']);
        allow delete: if isQuizCreator(quizId) || isExecutive();
      }
    }
  }

  // --- Executive Requests ---
  match /executive_requests/{requestId} {
    allow read: if isSignedIn() && (getRole() == 'executive' || (getRole() == 'commander' && resource.data.commanderId == request.auth.uid));
    allow create: if isSignedIn() && getRole() == 'commander';
    allow update: if isSignedIn() && getRole() == 'executive';
    allow delete: if false;
  }

  // --- Question Bank ---
  match /question_bank/{questionId} {
    // The question bank is internal: only commanders (AI import source) and
    // executives may read it. Gladiators never need direct access.
    allow read: if isExecutive() || isCommander();
    allow create, update, delete: if isSignedIn() && getRole() == 'executive';
  }

  // --- Platform Settings ---
  match /platform_settings/{docId} {
    allow read: if isSignedIn() && getRole() == 'executive';
    allow write: if isSignedIn() && getRole() == 'executive';
  }

  // --- Conversations ---
  match /conversations/{convId} {
    allow read: if isSignedIn() && resource.data.participants.hasAny([request.auth.uid]);
    allow create: if isExecutive();
    allow update, delete: if isExecutive();

    match /messages/{msgId} {
      allow read: if isSignedIn() && get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([request.auth.uid]);
      // Only self-authored messages from conversation participants.
      allow create: if isSignedIn()
        && get(/databases/$(database)/documents/conversations/$(convId)).data.participants.hasAny([request.auth.uid])
        && request.resource.data.senderId == request.auth.uid;
      allow delete: if isExecutive() || (isSignedIn() && request.auth.uid == resource.data.senderId);
    }
  }

  // --- Announcements ---
  match /announcements/{annId} {
    allow read: if isSignedIn();
    allow create, update, delete: if isExecutive();
  }

  // --- Notifications ---
  match /notifications/{notifId} {
    // Notifications are server-written and served through API routes;
    // clients may only read their own.
    allow read: if isOwner(resource.data.userId) || isExecutive();
    allow write: if false;
  }

  // --- Audit Logs ---
  match /auditLogs/{logId} {
    allow read: if isExecutive();
    allow write: if false;
  }

  // --- Battle Logs ---
  match /battle_logs/{logId} {
    allow read: if isSignedIn() && (
      isExecutive() ||
      isQuizCreator(resource.data.quizId) ||
      isQuizParticipant(resource.data.quizId, request.auth.uid)
    );
    // Client-side entries are restricted to the participant-originated events
    // and must be self-authored; all server events are written via Admin SDK.
    allow create: if isSignedIn() &&
      request.resource.data.keys().hasOnly(['quizId', 'event', 'actor', 'actorRole', 'timestamp', 'metadata', 'createdAt']) &&
      request.resource.data.actor == request.auth.uid &&
      request.resource.data.event in ['gladiator_joined', 'gladiator_left', 'gladiator_ready', 'gladiator_blocked', 'gladiator_unblocked'] &&
      (isQuizCreator(request.resource.data.quizId) ||
        isQuizParticipant(request.resource.data.quizId, request.auth.uid));
    allow update, delete: if false;
  }

  // --- AI Logs (server-only writes via Admin SDK; read by executives) ---
  match /ai_logs/{logId} {
    allow read: if isExecutive();
    allow write: if false;
  }

  // --- Security Logs (server-only; read by executives) ---
  match /security_logs/{logId} {
    allow read: if isExecutive();
    allow write: if false;
  }

  // --- Executive Requests subcollection ---
  match /executive_requests/{requestId}/responses/{responseId} {
    allow read: if isExecutive() || (
      isSignedIn() && getRole() == 'commander' &&
      get(/databases/$(database)/documents/executive_requests/$(requestId)).data.commanderId == request.auth.uid
    );
    allow create: if isExecutive();
  }

  // Collection group queries for student history
  match /{path=**}/participants/{userId} {
    allow read: if request.auth != null && request.auth.uid == userId;
  }
}