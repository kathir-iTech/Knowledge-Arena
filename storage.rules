// Storage is NOT provisioned on this Firebase project (Spark plan, requires Blaze).
// This file is inert — kept only so `firebase.json` storage block does not error
// on `firebase init`. Do NOT deploy with `firebase deploy --only storage`; use
// `firebase deploy --only firestore:rules,firestore:indexes` (see Part 2 hotfix).
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  // SIH-26242 RPL evidence images (Spark: Storage unprovisioned — inert until Blaze; active path is base64-in-Firestore).
  match /rpl-evidence/{workerId}/{filename} {
    allow write: if request.auth != null && request.auth.uid == workerId
      && request.resource.size < 5 * 1024 * 1024
      && request.resource.contentType.matches('image/.*');
  }
  }
}
